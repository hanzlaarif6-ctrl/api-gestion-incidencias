# Copia este fichero como .env para sobrescribir los valores por defecto de docker-compose.yml
DB_USUARIO=incidencias
DB_PASSWORD=cambia-esta-password

# Clave HMAC en Base64 de al menos 32 bytes. Para generar una:  openssl rand -base64 32
JWT_SECRETO=
JWT_EXPIRACION_MINUTOS=60

# "demo" carga datos de ejemplo; déjalo vacío para arrancar sin datos
SPRING_PROFILES_ACTIVE=demo
